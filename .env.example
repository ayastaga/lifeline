# --- AI provider: "openai" (v1) | "qwen" (phase 2, OpenAI-compatible vLLM endpoint)
AI_PROVIDER=openai
OPENAI_API_KEY=
# Pin the model: golden tests depend on it.
OPENAI_MODEL=gpt-4.1-2025-04-14
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen3-30B-A3B

# --- Embeddings (1024 dims): "openai" (text-embedding-3-large @1024) | "bge-m3" (self-hosted, OpenAI-compatible /v1/embeddings)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://localhost:8001
# Optional cross-encoder reranker exposing POST /rerank (e.g. TEI + bge-reranker-v2-m3)
RERANK_URL=
# Below this hybrid score, search_docs abstains and points to the official page.
RAG_MIN_SCORE=0.45

# --- Supabase. Leave blank to run with in-memory storage (demo mode, no RAG).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest
INGEST_USER_AGENT=lifeline-dev (student project; contact: you@example.com)
INGEST_SECRET=

# Set to 1 in production builds: fails `npm run check:verify` while anything has verify: true.
LIFELINE_ENFORCE_VERIFY=0

# --- Speech (milestone 1). Routes are per language; Sarvam is used for hi/pa only when SARVAM_API_KEY is set.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# JSON overrides, e.g. {"hi":"openai","default":"openai"} to compare providers on the audio golden set.
SPEECH_STT_ROUTES=
SPEECH_TTS_ROUTES=
